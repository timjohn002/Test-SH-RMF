# Copy to .env.local and fill in. Never commit real values.
# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Random string, 32+ bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
